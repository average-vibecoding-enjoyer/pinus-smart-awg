+func TestTCPIPv4FallbackNeverUsesOtherEgress(t *testing.T) {
+	for _, name := range []string{"missing-vpn-dns", "dns-error", "no-ipv4-answer", "ipv4-dial-error"} {
+		t.Run(name, func(t *testing.T) {
+			fixture := newFallbackFixture()
+			switch name {
+			case "missing-vpn-dns":
+				fixture.manager.tag = "different-tag"
+			case "dns-error":
+				fixture.dns.err = errors.New("synthetic DNS failure")
+			case "no-ipv4-answer":
+				fixture.dns.answers = []netip.Addr{fallbackIPv6.Addr, netip.MustParseAddr("::ffff:192.0.2.8")}
+			case "ipv4-dial-error":
+				fixture.dialer.retryError = errors.New("synthetic AWG IPv4 failure")
+			}
+			ctx := adapter.WithContext(context.Background(), &adapter.InboundContext{Domain: "www.google.com"})
+			connection, err := fixture.endpoint().DialContext(ctx, "tcp", fallbackIPv6)
+			if connection != nil || !errors.Is(err, fixture.dialer.firstError) {
+				t.Fatalf("must preserve original failure: conn=%v err=%v", connection, err)
+			}
+			want := 1
+			if name == "ipv4-dial-error" {
+				want = 2
+			}
+			if len(fixture.dialer.attempts) != want {
+				t.Fatalf("unexpected dial attempts: %v", fixture.dialer.attempts)
+			}
+		})
+	}
+}

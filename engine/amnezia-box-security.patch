+func selectPeerAddress(addresses []netip.Addr) (netip.Addr, error) {
+	for _, address := range addresses {
+		address = address.Unmap()
+		if address.Is4() {
+			return address, nil
+		}
+	}
+	for _, address := range addresses {
+		address = address.Unmap()
+		if address.Is6() {
+			return address, nil
+		}
+	}
+	return netip.Addr{}, E.New("peer hostname resolved without a usable IP address")
+}

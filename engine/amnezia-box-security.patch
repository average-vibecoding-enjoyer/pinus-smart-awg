+// These tests exercise the real AWG Endpoint.DialContext path. The terminal
+// AWG device and DNS exchange are replaced by memory implementations: there
+// are no OS sockets, listeners, TUNs, services, routes or profile secrets.
+func TestTCPIPv4FallbackAfterIPv6Unreachable(t *testing.T) {
+	fixture := newFallbackFixture()
+	endpoint := fixture.endpoint()
+	ctx := adapter.WithContext(context.Background(), &adapter.InboundContext{Domain: "www.google.com"})
+	connection, err := endpoint.DialContext(ctx, "tcp", fallbackIPv6)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	if len(fixture.dialer.attempts) != 2 || fixture.dialer.attempts[0] != fallbackIPv6 || fixture.dialer.attempts[1] != fallbackIPv4 {
+		t.Fatalf("AWG dial attempts = %v", fixture.dialer.attempts)
+	}
+	if fixture.dns.queries != 1 || fixture.dns.domain != "www.google.com" || fixture.dns.options.Transport != fixture.transport || fixture.dns.options.Strategy != C.DomainStrategyIPv4Only {
+		t.Fatalf("fallback did not use fixed VPN DNS + IPv4-only: %+v", fixture.dns)
+	}
+	if _, err := connection.Write([]byte("payload")); err != nil {
+		t.Fatal(err)
+	}
+	buffer := make([]byte, 7)
+	if _, err := io.ReadFull(connection, buffer); err != nil || string(buffer) != "payload" {
+		t.Fatalf("payload relay: %q, %v", buffer, err)
+	}
+}

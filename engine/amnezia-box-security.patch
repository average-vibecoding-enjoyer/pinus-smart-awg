+package awg
+
+import (
+	"github.com/sagernet/sing-box/option"
+	"net/netip"
+)
+
+// Resolver supplies only a synthetic address for syntax validation. Actual
+// hostname resolution happens later when the user starts this connection.
+func ValidateEndpointConfig(options option.AwgEndpointOptions) error {
+	_, err := genIpcConfig(options, func(string) (netip.Addr, error) { return netip.MustParseAddr("192.0.2.1"), nil })
+	return err
+}

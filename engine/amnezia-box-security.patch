diff --git a/protocol/awg/endpoint_test.go b/protocol/awg/endpoint_test.go
new file mode 100644
index 0000000..8b61e2f
--- /dev/null
+++ b/protocol/awg/endpoint_test.go
@@ -0,0 +1,35 @@
+package awg
+
+import (
+	"net/netip"
+	"testing"
+)
+
+func TestSelectPeerAddressPrefersIPv4(t *testing.T) {
+	selected, err := selectPeerAddress([]netip.Addr{
+		netip.MustParseAddr("2001:db8::1"),
+		netip.MustParseAddr("192.0.2.10"),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if selected.String() != "192.0.2.10" {
+		t.Fatalf("selected %v, want IPv4", selected)
+	}
+}
+
+func TestSelectPeerAddressFallsBackToIPv6(t *testing.T) {
+	selected, err := selectPeerAddress([]netip.Addr{netip.MustParseAddr("2001:db8::1")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if selected.String() != "2001:db8::1" {
+		t.Fatalf("selected %v, want IPv6", selected)
+	}
+}
+
+func TestSelectPeerAddressRejectsEmptyAnswer(t *testing.T) {
+	if _, err := selectPeerAddress(nil); err == nil {
+		t.Fatal("empty DNS answer was accepted")
+	}
+}

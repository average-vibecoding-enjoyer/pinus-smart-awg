diff --git a/cmd/sing-box/cmd_pinus_check.go b/cmd/sing-box/cmd_pinus_check.go
new file mode 100644
index 0000000..86eef93
--- /dev/null
+++ b/cmd/sing-box/cmd_pinus_check.go
@@ -0,0 +1,29 @@
+//go:build with_awg
+
+package main
+
+import (
+ "github.com/sagernet/sing-box/option"
+ "github.com/sagernet/sing-box/protocol/awg"
+ "github.com/spf13/cobra"
+)
+
+// Unlike the generic check command, this validation never constructs a box,
+// endpoint device, TUN, listener, routing manager or DNS transport.
+var commandPinusCheck = &cobra.Command{
+ Use:"pinus-check",Short:"Validate Pinus configuration without network side effects",
+ Args:cobra.NoArgs,
+ RunE:func(cmd *cobra.Command,args []string)error{
+  options,err:=readConfigAndMerge();if err!=nil{return err}
+  return validatePinusOptions(options)
+ },
+}
+func init(){ mainCommand.AddCommand(commandPinusCheck) }
+func validatePinusOptions(options option.Options) error {
+ for _, endpoint:=range options.Endpoints {
+  if config,ok:=endpoint.Options.(*option.AwgEndpointOptions);ok {
+   if err:=awg.ValidateEndpointConfig(*config);err!=nil{return err}
+  }
+ }
+ return nil
+}

+package awg
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"syscall"
+	"testing"
+
+	mDNS "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	boxDNS "github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/service"
+)
+
+func TestTCPIPv4FallbackOverridesDirectDNSRuleWithinVPN(t *testing.T) {
+	direct := &fallbackMemoryDNSTransport{TransportAdapter: boxDNS.NewTransportAdapter("memory", "direct-dns", nil), answer: netip.MustParseAddr("198.51.100.9")}
+	vpn := &fallbackMemoryDNSTransport{TransportAdapter: boxDNS.NewTransportAdapter("memory", "profile-dns-0", nil), answer: fallbackIPv4.Addr}
+	manager := &fallbackMemoryDNSManager{direct: direct, vpn: vpn}
+	ctx := service.ContextWith[adapter.DNSTransportManager](context.Background(), manager)
+	var options option.DNSOptions
+	if err := options.UnmarshalJSONContext(ctx, []byte(`{"rules":[{"domain":["vk.ru"],"action":"route","server":"direct-dns","strategy":"ipv4_only"}],"disable_cache":true}`)); err != nil {
+		t.Fatal(err)
+	}
+	router := boxDNS.NewRouter(ctx, log.NewNOPFactory(), options)
+	if err := router.Initialize(options.Rules); err != nil {
+		t.Fatal(err)
+	}
+	if err := router.Start(adapter.StartStateStart); err != nil {
+		t.Fatal(err)
+	}
+	defer router.Close()
+	// A process/custom VPN policy may override the direct domain policy for
+	// this connection. The fallback must still use the fixed VPN transport.
+	baseline, err := router.Lookup(ctx, "vk.ru", adapter.DNSQueryOptions{})
+	if err != nil || len(baseline) != 1 || baseline[0] != direct.answer || direct.queries != 1 || vpn.queries != 0 {
+		t.Fatalf("baseline DNS rule failed: %v %v", baseline, err)
+	}
+	direct.queries = 0
+	fixture := newFallbackFixture()
+	fixture.fallback.dns = router
+	fixture.fallback.transports = manager
+	metadata := &adapter.InboundContext{Domain: "vk.ru", Destination: fallbackIPv6}
+	ctx = adapter.WithContext(ctx, metadata)
+	conn, err := fixture.endpoint().DialContext(ctx, "tcp", fallbackIPv6)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+	if direct.queries != 0 || vpn.queries != 1 || len(fixture.dialer.attempts) != 2 || fixture.dialer.attempts[1] != fallbackIPv4 {
+		t.Fatalf("fallback DNS escaped VPN: direct=%d vpn=%d dials=%v", direct.queries, vpn.queries, fixture.dialer.attempts)
+	}
+	if metadata.Domain != "vk.ru" || metadata.Destination != fallbackIPv6 {
+		t.Fatal("DNS lookup mutated routing context")
+	}
+}
+
+func TestTCPIPv4FallbackRejectsInvalidConfigurationBeforeCreatingDevice(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		address netip.Prefix
+		manager adapter.DNSTransportManager
+	}{
+		{"IPv6-only", netip.MustParsePrefix("2001:db8::1/128"), nil},
+		{"no-manager", netip.MustParsePrefix("192.0.2.1/32"), nil},
+		{"missing-tag", netip.MustParsePrefix("192.0.2.1/32"), &fallbackDNSManager{tag: "other", transport: &fallbackDNSTransport{}}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx := context.Background()
+			if test.manager != nil {
+				ctx = service.ContextWith[adapter.DNSTransportManager](ctx, test.manager)
+			}
+			endpoint, err := NewEndpoint(ctx, nil, log.NewNOPFactory().NewLogger("test"), "awg-out", option.AwgEndpointOptions{Address: []netip.Prefix{test.address}, TCPIPv4FallbackResolver: "profile-dns-0"})
+			if endpoint != nil || err == nil {
+				t.Fatal("invalid fallback configuration accepted")
+			}
+		})
+	}
+}
+
+type fallbackMemoryDNSTransport struct {
+	boxDNS.TransportAdapter
+	answer  netip.Addr
+	queries int
+}
+
+func (d *fallbackMemoryDNSTransport) Start(adapter.StartStage) error { return nil }
+func (d *fallbackMemoryDNSTransport) Close() error                   { return nil }
+func (d *fallbackMemoryDNSTransport) Reset()                         {}
+func (d *fallbackMemoryDNSTransport) Exchange(_ context.Context, request *mDNS.Msg) (*mDNS.Msg, error) {
+	d.queries++
+	response := new(mDNS.Msg)
+	response.SetReply(request)
+	for _, q := range request.Question {
+		if q.Qtype == mDNS.TypeA {
+			response.Answer = append(response.Answer, &mDNS.A{Hdr: mDNS.RR_Header{Name: q.Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 60}, A: net.IP(d.answer.AsSlice())})
+		}
+	}
+	return response, nil
+}
+
+type fallbackMemoryDNSManager struct {
+	adapter.DNSTransportManager
+	direct, vpn *fallbackMemoryDNSTransport
+}
+
+func (m *fallbackMemoryDNSManager) Transport(tag string) (adapter.DNSTransport, bool) {
+	if tag == m.direct.Tag() {
+		return m.direct, true
+	}
+	if tag == m.vpn.Tag() {
+		return m.vpn, true
+	}
+	return nil, false
+}
+func (m *fallbackMemoryDNSManager) Default() adapter.DNSTransport { return m.direct }

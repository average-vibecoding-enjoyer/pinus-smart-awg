+		conn, err := fixture.endpoint().DialContext(ctx, "tcp", fallbackIPv6)
+		if conn != nil || !errors.Is(err, context.Canceled) || len(fixture.dialer.attempts) != 1 {
+			t.Fatalf("dial continued after cancellation: %v %v", conn, err)
+		}
+	})
+}

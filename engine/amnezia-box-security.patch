index 0000000..b4f0192
--- /dev/null
+++ b/protocol/awg/tcp_ipv4_fallback.go
@@ -0,0 +1,95 @@
+package awg
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// Some profiles advertise IPv6 even when their IPv6 path is unreachable.
+// Once the TUN has accepted the browser's TCP handshake, that failure becomes
+// a TLS-stage reset and the browser may no longer try its IPv4 address. Retry
+// only this failed dial, before any application payload has been forwarded.
+// The fixed DNS transport and the same AWG device preserve the chosen policy.
+// Missing/hidden hostnames and UDP cannot use this TCP-only recovery.
+type tcpIPv4Fallback struct {
+	resolver   string
+	dns        adapter.DNSRouter
+	transports adapter.DNSTransportManager
+	dialer     N.Dialer
+}
+
+func (f *tcpIPv4Fallback) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	connection, originalErr := f.dialer.DialContext(ctx, network, destination)
+	if originalErr == nil || network != N.NetworkTCP || !destination.IsIPv6() || ctx.Err() != nil || !isTCPNetworkUnreachable(originalErr) {
+		return connection, originalErr
+	}
+	metadata := adapter.ContextFrom(ctx)
+	if metadata == nil || f.resolver == "" || f.dns == nil || f.transports == nil {
+		return nil, originalErr
+	}
+	domain := strings.TrimSuffix(metadata.Domain, ".")
+	if !M.IsDomainName(domain) || M.ParseAddr(domain).IsValid() {
+		return nil, originalErr
+	}
+	transport, found := f.transports.Transport(f.resolver)
+	if !found || transport == nil {
+		return nil, errors.Join(originalErr, E.New("TCP IPv4 fallback DNS transport not found: ", f.resolver))
+	}
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	addresses, err := f.dns.Lookup(ctx, domain, adapter.DNSQueryOptions{
+		Transport: transport,
+		Strategy:  C.DomainStrategyIPv4Only,
+	})
+	if err != nil {
+		return nil, errors.Join(originalErr, E.Cause(err, "TCP IPv4 fallback DNS"))
+	}
+	var ipv4Addresses []netip.Addr
+	for _, address := range addresses {
+		// Never send a second IPv6 dial, even if a DNS implementation violates
+		// the requested family. Mapped IPv6 addresses are not IPv4 answers.
+		if address.Is4() {
+			ipv4Addresses = append(ipv4Addresses, address)
+		}
+	}
+	if len(ipv4Addresses) == 0 {
+		return nil, errors.Join(originalErr, E.New("TCP IPv4 fallback DNS returned no IPv4 address"))
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, errors.Join(originalErr, err)
+	}
+	connection, err = N.DialSerial(ctx, f.dialer, network, M.Socksaddr{Fqdn: domain, Port: destination.Port}, ipv4Addresses)
+	if err != nil {
+		return nil, errors.Join(originalErr, E.Cause(err, "TCP IPv4 fallback dial"))
+	}
+	return connection, nil
+}
+
+func isTCPNetworkUnreachable(err error) bool {
+	var operation *net.OpError
+	if !errors.As(err, &operation) || operation.Op != "connect" || operation.Net != N.NetworkTCP || operation.Err == nil {
+		return false
+	}
+	if errors.Is(operation.Err, syscall.ENETUNREACH) || errors.Is(operation.Err, syscall.EHOSTUNREACH) {
+		return true
+	}
+	// The pinned gVisor gonet bridge converts tcpip errors to errors.New,
+	// losing errno/type identity. Match only its exact connect error causes.
+	switch operation.Err.Error() {
+	case "network is unreachable", "no route to host":
+		return true
+	default:
+		return false
+	}
+}

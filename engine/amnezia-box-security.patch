+var fallbackIPv6 = M.Socksaddr{Addr: netip.MustParseAddr("2001:db8::8"), Port: 443}
+var fallbackIPv4 = M.Socksaddr{Addr: netip.MustParseAddr("192.0.2.8"), Port: 443}
+
+func fallbackUnreachable() error {
+	return &net.OpError{Op: "connect", Net: "tcp", Addr: net.TCPAddrFromAddrPort(fallbackIPv6.AddrPort()), Err: errors.New("network is unreachable")}
+}
+
+type fallbackDNS struct {
+	adapter.DNSRouter
+	queries     int
+	domain      string
+	options     adapter.DNSQueryOptions
+	answers     []netip.Addr
+	err         error
+	afterLookup func()
+}
+
+func (d *fallbackDNS) Lookup(_ context.Context, domain string, options adapter.DNSQueryOptions) ([]netip.Addr, error) {
+	d.queries++
+	d.domain = domain
+	d.options = options
+	if d.afterLookup != nil {
+		d.afterLookup()
+	}
+	return d.answers, d.err
+}
+
+type fallbackDNSManager struct {
+	adapter.DNSTransportManager
+	tag       string
+	transport adapter.DNSTransport
+}
+
+func (m *fallbackDNSManager) Transport(tag string) (adapter.DNSTransport, bool) {
+	return m.transport, tag == m.tag
+}
+
+type fallbackDNSTransport struct{ adapter.DNSTransport }
+type fallbackDialer struct {
+	attempts               []M.Socksaddr
+	firstError, retryError error
+}
+
+func (d *fallbackDialer) DialContext(_ context.Context, _ string, destination M.Socksaddr) (net.Conn, error) {
+	d.attempts = append(d.attempts, destination)
+	if len(d.attempts) == 1 && d.firstError != nil {
+		return nil, d.firstError
+	}
+	if len(d.attempts) > 1 && d.retryError != nil {
+		return nil, d.retryError
+	}
+	client, server := net.Pipe()
+	go func() {
+		defer server.Close()
+		buffer := make([]byte, 7)
+		if _, err := io.ReadFull(server, buffer); err == nil {
+			server.Write(buffer)
+		}
+	}()
+	return client, nil
+}
+func (d *fallbackDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	panic("unexpected UDP listener")
+}
+
+type fallbackFixture struct {
+	fallback  *tcpIPv4Fallback
+	dns       *fallbackDNS
+	manager   *fallbackDNSManager
+	transport *fallbackDNSTransport
+	dialer    *fallbackDialer
+}
+
+func newFallbackFixture() *fallbackFixture {
+	f := &fallbackFixture{dns: &fallbackDNS{answers: []netip.Addr{fallbackIPv6.Addr, fallbackIPv4.Addr}}, transport: &fallbackDNSTransport{}, dialer: &fallbackDialer{firstError: fallbackUnreachable()}}
+	f.manager = &fallbackDNSManager{tag: "profile-dns-0", transport: f.transport}
+	f.fallback = &tcpIPv4Fallback{resolver: "profile-dns-0", dns: f.dns, transports: f.manager, dialer: f.dialer}
+	return f
+}
+func (f *fallbackFixture) endpoint() *Endpoint {
+	return &Endpoint{logger: log.NewNOPFactory().NewLogger("test"), tcpIPv4Fallback: f.fallback}
+}

+func TestTCPUnreachableClassification(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{"gvisor-network", fallbackUnreachable(), true},
+		{"gvisor-host", &net.OpError{Op: "connect", Net: "tcp", Err: errors.New("no route to host")}, true},
+		{"errno-network", &net.OpError{Op: "connect", Net: "tcp", Err: syscall.ENETUNREACH}, true},
+		{"errno-host", &net.OpError{Op: "connect", Net: "tcp", Err: syscall.EHOSTUNREACH}, true},
+		{"bare-string", errors.New("network is unreachable"), false},
+		{"wrong-operation", &net.OpError{Op: "write", Net: "tcp", Err: syscall.ENETUNREACH}, false},
+		{"wrong-network", &net.OpError{Op: "connect", Net: "udp", Err: syscall.ENETUNREACH}, false},
+		{"substring", &net.OpError{Op: "connect", Net: "tcp", Err: errors.New("server says network is unreachable")}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := isTCPNetworkUnreachable(tc.err); got != tc.want {
+				t.Fatalf("got %v, want %v", got, tc.want)
+			}
+		})
+	}
+}

+func TestTCPIPv4FallbackKeepsOtherPathsUnchanged(t *testing.T) {
+	for _, tc := range []struct {
+		name, network, domain string
+		destination           M.Socksaddr
+		firstError            error
+		resolver              string
+		canceled              bool
+	}{
+		{"working-ipv6", "tcp", "www.google.com", fallbackIPv6, nil, "profile-dns-0", false},
+		{"disabled-negative-control", "tcp", "www.google.com", fallbackIPv6, fallbackUnreachable(), "", false},
+		{"ipv4", "tcp", "www.google.com", fallbackIPv4, fallbackUnreachable(), "profile-dns-0", false},
+		{"udp", "udp", "www.google.com", fallbackIPv6, fallbackUnreachable(), "profile-dns-0", false},
+		{"unknown-host", "tcp", "", fallbackIPv6, fallbackUnreachable(), "profile-dns-0", false},
+		{"literal-host", "tcp", "192.0.2.8", fallbackIPv6, fallbackUnreachable(), "profile-dns-0", false},
+		{"invalid-host", "tcp", "bad/domain", fallbackIPv6, fallbackUnreachable(), "profile-dns-0", false},
+		{"connection-refused", "tcp", "www.google.com", fallbackIPv6, &net.OpError{Op: "connect", Net: "tcp", Err: syscall.ECONNREFUSED}, "profile-dns-0", false},
+		{"connection-reset", "tcp", "www.google.com", fallbackIPv6, &net.OpError{Op: "connect", Net: "tcp", Err: syscall.ECONNRESET}, "profile-dns-0", false},
+		{"timeout", "tcp", "www.google.com", fallbackIPv6, context.DeadlineExceeded, "profile-dns-0", false},
+		{"canceled", "tcp", "www.google.com", fallbackIPv6, fallbackUnreachable(), "profile-dns-0", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fixture := newFallbackFixture()
+			fixture.dialer.firstError = tc.firstError
+			fixture.fallback.resolver = tc.resolver
+			ctx, cancel := context.WithCancel(adapter.WithContext(context.Background(), &adapter.InboundContext{Domain: tc.domain}))
+			defer cancel()
+			if tc.canceled {
+				cancel()
+			}
+			connection, err := fixture.endpoint().DialContext(ctx, tc.network, tc.destination)
+			if connection != nil {
+				connection.Close()
+			}
+			if !errors.Is(err, tc.firstError) || len(fixture.dialer.attempts) != 1 || fixture.dns.queries != 0 {
+				t.Fatalf("unexpected fallback: err=%v attempts=%v queries=%d", err, fixture.dialer.attempts, fixture.dns.queries)
+			}
+		})
+	}
+}

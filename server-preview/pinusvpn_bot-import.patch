+def get_pinus_import_store():
+    global _pinus_import_store
+    origin = os.environ.get("PINUS_IMPORT_ORIGIN", "")
+    if not origin:
+        return None
+    if _pinus_import_store is None:
+        from pathlib import Path
+        from pinus_import import TokenStore
+        store = TokenStore(
+            Path(os.environ["PINUS_IMPORT_DB"]),
+            Path(os.environ["PINUS_IMPORT_KEY_FILE"]).read_bytes(),
+            origin,
+        )
+        store.initialize()
+        _pinus_import_store = store
+    return _pinus_import_store

<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?if $(var.Platform) = "x86" ?>
    <?define ProgramFilesFolderId = "ProgramFilesFolder" ?>
    <?define ComponentWin64 = "no" ?>
    <?define ClientComponentGuid = "*" ?>
    <?define EngineComponentGuid = "*" ?>
    <?define WintunComponentGuid = "*" ?>
    <?define DocsComponentGuid = "*" ?>
    <?define StartMenuComponentGuid = "{C5B1A85B-4133-5F6F-BBEC-CDE5BB3F51B6}" ?>
    <?define DesktopComponentGuid = "{3A978FAD-25A6-527E-A4CC-DA55F8D1D4F1}" ?>
    <?define RegistrySearchWin64 = "no" ?>
  <?elseif $(var.Platform) = "arm64" ?>
    <?define ProgramFilesFolderId = "ProgramFiles64Folder" ?>
    <?define ComponentWin64 = "yes" ?>
    <?define ClientComponentGuid = "*" ?>
    <?define EngineComponentGuid = "*" ?>
    <?define WintunComponentGuid = "*" ?>
    <?define DocsComponentGuid = "*" ?>
    <?define StartMenuComponentGuid = "{F927BA98-32D2-5401-8777-3617FD760C99}" ?>
    <?define DesktopComponentGuid = "{BD2ABA5B-FDEE-52EC-9FCD-A40E4D2DEA58}" ?>
    <?define RegistrySearchWin64 = "yes" ?>
  <?else ?>
    <?define ProgramFilesFolderId = "ProgramFiles64Folder" ?>
    <?define ComponentWin64 = "yes" ?>
    <?define ClientComponentGuid = "*" ?>
    <?define EngineComponentGuid = "*" ?>
    <?define WintunComponentGuid = "*" ?>
    <?define DocsComponentGuid = "*" ?>
    <?define StartMenuComponentGuid = "{6947CD59-B139-53DE-9A71-39D81769DFCC}" ?>
    <?define DesktopComponentGuid = "{E8AAED69-7A1B-5F70-A989-E945E0B226AE}" ?>
    <?define RegistrySearchWin64 = "yes" ?>
  <?endif ?>

  <Product
    Id="*"
    Name="Pinus Smart AWG Preview"
    Language="1049"
    Version="$(var.AppVersion)"
    Manufacturer="Pinus VPN"
    UpgradeCode="{B8060DFA-C950-55AC-818D-D9546D665372}">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="$(var.Platform)"
      Description="Pinus Smart AWG $(var.ArchLabel)" />

    <MajorUpgrade
      AllowDowngrades="no"
      DowngradeErrorMessage="A newer version of Pinus Smart AWG is already installed."
      Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPPRODUCTICON" Value="PinusIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://t.me/MEN9_HET" />
    <Property Id="ARPCONTACT" Value="https://t.me/MEN9_HET" />
    <Property Id="MSIFASTINSTALL" Value="1" />
    <Property Id="PINUS_WINDOWS_BUILD">
      <RegistrySearch
        Id="PinusWindowsBuildSearch"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
        Name="CurrentBuildNumber"
        Type="raw"
        Win64="$(var.RegistrySearchWin64)" />
    </Property>
    <Icon Id="PinusIcon" SourceFile="$(var.IconPath)" />

    <Condition Message="Windows 10 or later is required.">Installed OR (PINUS_WINDOWS_BUILD AND PINUS_WINDOWS_BUILD &gt;= 10240)</Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="$(var.ProgramFilesFolderId)">
        <Directory Id="PinusRootFolder" Name="Pinus Smart AWG Preview">
          <Directory Id="VersionsFolder" Name="Versions">
            <Directory Id="INSTALLFOLDER" Name="$(var.AppVersion)" />
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="CommonProgramsFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Pinus Smart AWG Preview" />
      </Directory>
      <Directory Id="CommonDesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ClientFile" Guid="$(var.ClientComponentGuid)" Win64="$(var.ComponentWin64)">
        <File Id="PinusSmartAWGExe" Source="$(var.BundleDir)\PinusSmartAWG.exe" KeyPath="yes" Checksum="yes" />
      </Component>
      <Component Id="EngineFile" Guid="$(var.EngineComponentGuid)" Win64="$(var.ComponentWin64)">
        <File Id="AmneziaBoxExe" Source="$(var.BundleDir)\amnezia-box.exe" Checksum="yes" />
      </Component>
      <Component Id="WintunFile" Guid="$(var.WintunComponentGuid)" Win64="$(var.ComponentWin64)">
        <File Id="WintunDll" Source="$(var.BundleDir)\wintun.dll" Checksum="yes" />
      </Component>
      <Component Id="PackageReadmeComponent" Guid="*" Win64="$(var.ComponentWin64)">
        <File Id="PackageReadme" Source="$(var.BundleDir)\README.txt" KeyPath="yes" />
      </Component>
      <Component Id="ClientLicenseComponent" Guid="*" Win64="$(var.ComponentWin64)">
        <File Id="ClientLicense" Source="$(var.BundleDir)\LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Id="EngineLicenseComponent" Guid="*" Win64="$(var.ComponentWin64)">
        <File Id="EngineLicense" Source="$(var.BundleDir)\ENGINE-LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Id="WintunLicenseComponent" Guid="*" Win64="$(var.ComponentWin64)">
        <File Id="WintunLicense" Source="$(var.BundleDir)\WINTUN-LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyNoticesComponent" Guid="*" Win64="$(var.ComponentWin64)">
        <File Id="ThirdPartyNotices" Source="$(var.BundleDir)\THIRD-PARTY-NOTICES.txt" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="$(var.StartMenuComponentGuid)" Win64="$(var.ComponentWin64)">
        <Shortcut
          Id="StartMenuPinusShortcut"
          Name="Pinus Smart AWG Preview"
          Description="Pinus Smart AWG VPN client"
          Target="[INSTALLFOLDER]PinusSmartAWG.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Pinus VPN\Pinus Smart AWG Preview"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="CommonDesktopFolder">
      <Component Id="DesktopShortcut" Guid="$(var.DesktopComponentGuid)" Win64="$(var.ComponentWin64)">
        <Shortcut
          Id="DesktopPinusShortcut"
          Name="Pinus Smart AWG Preview"
          Description="Pinus Smart AWG VPN client"
          Target="[INSTALLFOLDER]PinusSmartAWG.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Pinus VPN\Pinus Smart AWG Preview"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="Pinus Smart AWG" Level="1" Absent="disallow">
      <ComponentRef Id="ClientFile" />
      <ComponentRef Id="EngineFile" />
      <ComponentRef Id="WintunFile" />
      <ComponentRef Id="PackageReadmeComponent" />
      <ComponentRef Id="ClientLicenseComponent" />
      <ComponentRef Id="EngineLicenseComponent" />
      <ComponentRef Id="WintunLicenseComponent" />
      <ComponentRef Id="ThirdPartyNoticesComponent" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <CustomAction
      Id="InstallManagerService"
      FileKey="PinusSmartAWGExe"
      ExeCommand="/installmanagerservicequiet"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="UninstallPinusServices"
      FileKey="PinusSmartAWGExe"
      ExeCommand="/uninstallallservices"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstallManagerService" After="InstallFiles">NOT Installed OR REINSTALL</Custom>
      <Custom Action="UninstallPinusServices" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Product>
</Wix>
